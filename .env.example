# Noisette Patissier — environment (plan.md #5)
#
# Copy to .env.local and fill in. With none of these set, the app runs on the
# Phase 1 in-memory maps (fine for local dev and `node --test`). Setting them
# switches the matching subsystem to durable, shared storage.
#
# In production ALL of the durable-state vars below are required; the app
# refuses to boot without them (see lib/db/backend.js).

# --- Postgres (Supabase or Neon) ---
# Use the CONNECTION POOLER endpoint for serverless:
#   Supabase: ...pooler.supabase.com:6543/postgres?pgbouncer=true
#   Neon:     the "Pooled connection" host
DATABASE_URL=
# Optional: max clients in this process's pool (default 5). Keep low on serverless.
PG_POOL_MAX=5

# --- Upstash Redis (REST) ---
# From the Upstash console, "REST API" section of your database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments (already used by lib/payments.js) ---
# HMAC secret the payment provider signs webhooks with. Required in production;
# without it every callback is rejected (fail-closed).
PAYMENT_WEBHOOK_SECRET=

# --- Staff counter PIN (already used by lib/staff.js) ---
# Shared counter PIN. Required in production; no default there.
STAFF_PIN=
